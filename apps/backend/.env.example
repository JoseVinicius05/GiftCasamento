# Postgres local (via docker-compose na raiz do projeto)
DATABASE_URL="postgresql://gift_list:gift_list@localhost:5432/gift_casamento_dev?schema=public"
PORT=3001
FRONTEND_URL=http://localhost:3000

# Em produção (Render/Railway) essas variáveis são configuradas no painel do serviço:
#   DATABASE_URL  -> connection string do Neon
#   FRONTEND_URL  -> URL do frontend na Vercel (sem barra no final)
#   PORT          -> o próprio Render/Railway define, não precisa configurar
