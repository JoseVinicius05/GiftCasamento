# Postgres local (via docker-compose na raiz do projeto)
DATABASE_URL="postgresql://gift_list:gift_list@localhost:5432/gift_casamento_dev?schema=public"
PORT=3001
FRONTEND_URL=http://localhost:3000

# Chave usada pra assinar o JWT. Gere a sua com: openssl rand -hex 32
# (ou "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
# se não tiver openssl no Windows). NUNCA reaproveite o valor de exemplo abaixo.
JWT_SECRET=troque-por-uma-chave-aleatoria-de-32-bytes

# Em produção (Render/Railway) essas variáveis são configuradas no painel do serviço:
#   DATABASE_URL  -> connection string do Neon
#   FRONTEND_URL  -> URL do frontend na Vercel (sem barra no final)
#   PORT          -> o próprio Render/Railway define, não precisa configurar

# Mercado Livre (OAuth) — Sprint 3.
# Credenciais do app cadastrado em https://developers.mercadolivre.com.br
# A redirect_uri precisa ser IDÊNTICA à cadastrada no painel do Mercado Livre.
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
MERCADOLIVRE_REDIRECT_URI=https://giftcasamento.onrender.com/auth/mercadolivre/callback

# Chave simples que protege GET /auth/mercadolivre/connect (acessada direto
# no navegador, por isso não usa o JWT de login). Gere a sua com:
# node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
MERCADOLIVRE_SETUP_KEY=troque-por-uma-chave-aleatoria

# Amazon — Sprint 3. Bright Data é a integração principal (scraper de
# produto), Microlink é usado só como fallback técnico se a Bright Data
# falhar ou devolver dados incompletos.
BRIGHTDATA_API_KEY=
MICROLINK_API_KEY=
